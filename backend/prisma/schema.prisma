generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  imageUrl    String?
  liveUrl     String?
  repoUrl     String?
  tags        String[]
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Skill {
  id       Int    @id @default(autoincrement())
  name     String @unique
  category String
  level    Int    @default(1)
}

model Message {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String?
  content   String
  createdAt DateTime @default(now())
}
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
}